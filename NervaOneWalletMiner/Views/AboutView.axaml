<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:NervaOneWalletMiner.ViewModels"			 
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
             x:Class="NervaOneWalletMiner.Views.AboutView">

	<Design.DataContext>
		<vm:DaemonSetupViewModel/>
	</Design.DataContext>

	<StackPanel HorizontalAlignment="Stretch"
				Spacing="5"				
				ScrollViewer.AllowAutoHide="True"
				Margin="10"
				MaxWidth="650">
		<Grid ColumnDefinitions="32,*">
			<Image Grid.Row="0"
				   Grid.Column="0"
				   Name="imgCoinIcon"/>
			<Label Grid.Row="0"
				   Grid.Column="1"
				   Content="About NervaOne"
				   Height="24"
				   Margin="5,0,0,0"/>
		</Grid>

		<TextBlock Name="tbkVersion" TextWrapping="Wrap" Margin="0,10,0,0">
			Version
		</TextBlock>

		<TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
			NervaOne Wallet and Miner is an open source, multi-coin
			wallet and CPU miner created by The Nerva Project.
		</TextBlock>

		<Button Name="btnGitHub"
			Content="NervaOne GitHub"
			Margin="0,10,0,0"
			Click="OpenGitHub_Clicked"/>

		<TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
			NervaOne is a non-custodial application that runs as a full node by executing
			the coin's CLI tools directly on your device, or as wallet-only by connecting
			to a remote node.
		</TextBlock>

		<TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
			By running a full node in NervaOne, you help decentralize
			the blockchains of the coins you support. Your keys and wallet
			stay on your device - you are your own bank.
		</TextBlock>

		<TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
			NervaOne has a modern design that's easy to use for newcomers,
			while giving advanced users the ability to customize.
		</TextBlock>

		<TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
			If you need help with NervaOne or just want to say Hi,
			stop by Nerva's Discord or Telegram:
		</TextBlock>

		<Button Name="btnDiscord"
			Content="Nerva Discord"
			Margin="0,10,0,0"
			Click="OpenDiscord_Clicked"/>

		<Button Name="btnTelegram"
			Content="Nerva Telegram"
			Margin="0,10,0,0"
			Click="OpenTelegram_Clicked"/>

	</StackPanel>
	
</UserControl>
